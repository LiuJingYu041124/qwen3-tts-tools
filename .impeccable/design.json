  "narrative": {
    "northStar": "电影声音剪辑台",
    "overview": "声场把角色、台词和生成状态呈现为可剪接的声音素材，而不是普通管理后台。暗靛蓝工作面承载长时间操作，暖琥珀播放线只标记当前动作与生成焦点，克隆声线以冷蓝与场景造声区分。",
    "keyCharacteristics": ["暗色本地工作面", "琥珀播放与主动作", "冷蓝授权克隆", "轨道式高密度布局", "文字与图形共同表达状态"],
    "rules": [
      {"name": "The Signal Color Rule", "body": "琥珀和克隆蓝必须绑定功能语义，不能作为随机装饰。", "section": "colors"},
      {"name": "The Dialogue Leads Rule", "body": "台词正文必须比控件标签和元数据明显更大、更亮。", "section": "typography"},
      {"name": "The Flat Bench Rule", "body": "编辑工作面默认平坦；只有脱离文档流的浮层获得大阴影。", "section": "elevation"}
    ],
    "dos": ["Do 把角色、台词和声音来源放在首屏可操作区域。", "Do 用轨道、标尺、编号和分栏表达专业声音工作流。", "Do 在窄屏把表格重组为纵向台词编辑。"],
    "donts": ["Don't 将主工作区重构成同尺寸图标卡片网格。", "Don't 混淆授权克隆与虚构造声。", "Don't 为每个静态容器同时使用边框和阴影。"]
